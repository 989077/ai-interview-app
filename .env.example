# Which engine to use: "ollama" (free, runs on your computer) or "anthropic" (paid Claude API)
LLM_PROVIDER=ollama

# Ollama settings (default). Install from ollama.com, then run: ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_SCORING_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-4-5
